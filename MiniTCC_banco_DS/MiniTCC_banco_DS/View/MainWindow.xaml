<Window x:Class="MiniTCC_banco_DS.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Controle de Resíduos"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen">
        <!-- Define a janela de forma centralizada na tela -->


    <Grid Background="#FFF">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>


        <!-- Topo e Titulo Principal -->

        <Border Grid.Row="0"
                Background="#B6D0E2">

            <TextBlock Text="ECOSORT - LIXEIRA INTELIGENTE"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

        </Border>


        <!-- Seção de opções -->

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="350">

            <TextBlock Text="Seja bem-vindo ao EcoSort"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Selecione uma opção para acessar o sistema."
                       FontSize="15"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>


            <Button Content="Cadastro de Lixeiras"
                    Height="50"
                    Margin="0,5"
                    FontSize="16"/>

            <Button Content="Cadastro de Resíduos"
                    Height="50"
                    Margin="0,5"
                    FontSize="16"/>

            <Button Content="Consultar Registros"
                    Height="50"
                    Margin="0,5"
                    FontSize="16"/>

        </StackPanel>


        <!-- Rodapé -->

        <Border Grid.Row="2"
                Background="#DDDDDD">

            <TextBlock Text="Mini TCC - João Paulo, Enzo, Crystian, Bruno Yugue"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"/>

        </Border>

    </Grid>

</Window>