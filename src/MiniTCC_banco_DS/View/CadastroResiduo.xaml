<Window x:Class="MiniTCC_banco_DS.View.CadastroResiduo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniTCC_banco_DS.View"
        mc:Ignorable="d"
        Title="CadastroResiduo" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="131*"/>
            <RowDefinition Height="86*"/>
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform Angle="-0.043"/>
                <TranslateTransform/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Titulo Principal e Fundo-->
        <TextBlock HorizontalAlignment="Left" Margin="27,34,0,0" VerticalAlignment="Top" Text="RESIDUOS" RenderTransformOrigin="0.424,1.503" Opacity="0.67" FontSize="50" FontWeight="Bold" Foreground="black"/>
        <TextBlock Margin="29,27,0,0" VerticalAlignment="Top" Text="CADASTRO" RenderTransformOrigin="0.424,1.503" Opacity="0.67" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Foreground="black"/>
        <TextBlock Margin="240,26,0,0" VerticalAlignment="Top" Text="DE" RenderTransformOrigin="0.424,1.503" Opacity="0.67" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Foreground="black"/>
        <Label Height="auto" VerticalAlignment="Top" HorizontalAlignment="Center" Width="auto" FontSize="350" FontFamily="Segoe UI Variable Text Semibold" Opacity="0.030" Margin="0,-51,0,0" Grid.RowSpan="2" >
            <ComboBox Width="120"/>
        </Label>

        <!-- Botão Voltar -->
        <Button x:Name="BtnVoltar" Content="Voltar" HorizontalAlignment="Left" Height="24" Margin="40,77,0,0" Grid.Row="1" VerticalAlignment="Top" Width="75" Click="BtnVoltar_Click_1"/>


        <!-- Inserção de Dados -->
        <Label Content="ID RESÍDUO:" HorizontalAlignment="Left" Margin="307,112,0,0" VerticalAlignment="Top" Width="110"/>
        <Label Content="NOME:" HorizontalAlignment="Left" Margin="307,160,0,0" VerticalAlignment="Top" Width="110"/>
        <Label Content="TIPO:" HorizontalAlignment="Left" Margin="302,259,0,0" VerticalAlignment="Top" Width="110" Grid.RowSpan="2"/>
        <Label Content="CÒDIGO DE IDENTIFICAÇÃO:" HorizontalAlignment="Left" Margin="302,211,0,0" VerticalAlignment="Top" Width="193"/>

        <TextBox x:Name="TxtNome" HorizontalAlignment="Left" Margin="312,143,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="200" BorderBrush="Black"/>
        <TextBox x:Name="TxtId" HorizontalAlignment="Left" Margin="314,143,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" BorderBrush="Black"/>
        <TextBox x:Name="TxtConf" HorizontalAlignment="Left" Margin="307,242,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" BorderBrush="Black"/>

        <!-- Envio/Exclusão de Dados-->
        <Button x:Name="BtnEnviar" Content="Enviar" HorizontalAlignment="Left" Height="24" Margin="429,79,0,0" Grid.Row="1" VerticalAlignment="Top" Width="75" Click="BtnEnviar_Click"/>
        <Button x:Name="BtnApagar" Content="Apagar" HorizontalAlignment="Left" Height="24" Margin="304,79,0,0" Grid.Row="1" VerticalAlignment="Top" Width="75" Click="BtnApagar_Click"/>

        <!-- Rodapé -->
        <Border Background="#e9ecef" Margin="1,131,-1,1" Grid.Row="1">

            <TextBlock Text="Mini TCC - João Paulo, Enzo Basso, Crystian Leonardo, Bruno Yugue"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="Gray"/>

        </Border>
        <ComboBox x:Name="CmbTipo" HorizontalAlignment="Left" Margin="310,29,0,0" Grid.Row="1" VerticalAlignment="Top" Width="192">
            <ComboBoxItem x:Name="Papel" Content="Papel"/>
            <ComboBoxItem x:Name="Plastico" Content="Plastico"/>
            <ComboBoxItem x:Name="Metal" Content="Metal"/>
            <ComboBoxItem x:Name="Organico" Content="Organico"/>
            <ComboBoxItem x:Name="Vidro" Content="Vidro"/>
        </ComboBox>


    </Grid>
</Window>
